---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaButtons from '../components/CtaButtons.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { bairrosPorZona, bairroPath, zonasPrioritarias } from '../data/bairros';
import { breadcrumbSchema } from '../data/schema';

const crumbs = [
  { name: 'Início', path: '/' },
  { name: 'Áreas atendidas', path: '/areas-atendidas/' },
];
---

<Base
  title={`Áreas Atendidas: Desentupidora 24h em SP e Grande SP | ${site.name}`}
  description={`Desentupidora 24 horas nas Zonas Norte, Sul, Leste, Oeste e Centro de São Paulo, no ABC, em Guarulhos, Osasco e em toda a Grande SP. Chegamos em até ${site.arrivalMinutes} minutos.`}
  schema={[breadcrumbSchema(crumbs)]}
>
  <section class="hero page-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <span class="eyebrow">Áreas atendidas</span>
      <h1>Desentupidora em São Paulo e Grande SP</h1>
      <p class="hero-lead">Atendemos 24 horas em todas as zonas da capital e nas cidades da Grande São Paulo. Encontre a sua região.</p>
      <CtaButtons />
    </div>
  </section>
  <section class="section section-soft">
    <div class="container zones">
      {
        bairrosPorZona().map((g) => (
          <div class:list={['zone', { 'is-priority': zonasPrioritarias.includes(g.zona) }]}>
            <h2 style="font-size:1.6rem">
              {g.zona}
              {zonasPrioritarias.includes(g.zona) && <span class="tag">Foco</span>}
            </h2>
            <ul>
              {g.bairros.map((b) => (
                <li>
                  <a href={bairroPath(b)}>
                    <Icon name="pin" size={16} /> Desentupidora {b.em}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
  <CtaBand />
</Base>
