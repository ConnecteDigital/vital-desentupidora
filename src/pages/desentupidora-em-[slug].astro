---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaButtons from '../components/CtaButtons.astro';
import CtaBand from '../components/CtaBand.astro';
import FaqList from '../components/FaqList.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { site } from '../data/site';
import { servicos } from '../data/servicos';
import { bairros, bairroPath, type Bairro } from '../data/bairros';
import { breadcrumbSchema, faqSchema } from '../data/schema';

export function getStaticPaths() {
  return bairros.map((bairro) => ({ params: { slug: bairro.slug }, props: { bairro } }));
}

interface Props {
  bairro: Bairro;
}

const { bairro } = Astro.props;
const path = bairroPath(bairro);
// "Barão Geraldo, Campinas" para bairros; só o nome para cidades
const local = bairro.bairroDeCampinas ? `${bairro.nome}, Campinas` : bairro.nome;
const tipoVizinhos = bairro.bairroDeCampinas ? 'bairros vizinhos' : 'cidades vizinhas';
const crumbs = [
  { name: 'Início', path: '/' },
  { name: 'Áreas atendidas', path: '/areas-atendidas/' },
  { name: `Desentupidora em ${bairro.nome}`, path },
];
const faq = [
  {
    q: `Vocês atendem em ${bairro.nome} 24 horas?`,
    a: `Sim. Atendemos ${bairro.nome} e ${tipoVizinhos} 24 horas por dia, inclusive fins de semana e feriados.`,
  },
  {
    q: `Em quanto tempo a desentupidora chega em ${bairro.nome}?`,
    a: `Chegamos em até ${site.arrivalMinutes} minutos em ${bairro.nome}.`,
  },
  {
    q: `Atendem também ${bairro.vizinhos.slice(0, 2).join(' e ')}?`,
    a: `Sim. Além de ${bairro.nome}, atendemos ${bairro.vizinhos.join(', ')} e toda a região de Campinas.`,
  },
  {
    q: 'O serviço tem garantia?',
    a: `Sim. Todos os serviços da ${site.name} têm garantia.`,
  },
];
const outrosBairros = bairros.filter((b) => b.slug !== bairro.slug);
const msg = `Olá! Vim pelo site da ${site.name} e preciso de um desentupimento em ${bairro.nome}.`;
---

<Base
  title={`Desentupidora em ${bairro.nome} 24h | ${site.name}`}
  description={`Desentupidora em ${local}. Esgoto, pia, vaso sanitário, ralo e caixa de gordura 24 horas. Chegamos em até ${site.arrivalMinutes} minutos, com garantia.`}
  schema={[faqSchema(faq), breadcrumbSchema(crumbs)]}
>
  <section class="hero page-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <span class="eyebrow">{bairro.bairroDeCampinas ? 'Campinas · SP' : `${bairro.zona} · SP`}</span>
      <h1>Desentupidora em {bairro.nome} 24 horas</h1>
      <p class="hero-lead">
        Entupiu em {bairro.nome}? A {site.name} atende 24 horas e chega em até {site.arrivalMinutes} minutos para
        desentupir esgoto, pia, vaso, ralo e caixa de gordura, sem quebra-quebra e com garantia.
      </p>
      <CtaButtons message={msg} />
    </div>
  </section>

  <section class="section">
    <div class="container content-grid">
      <article class="prose">
        <h2>Desentupidora 24h em {bairro.nome}</h2>
        <p>{bairro.sobre}</p>
        <p>
          Nossa equipe atende {bairro.nome} e {tipoVizinhos}, como {bairro.vizinhos.join(', ')}. Assim que você chama, a
          equipe já sai para o endereço com as máquinas de desentupimento.
        </p>

        <h2>O que fazemos em {bairro.nome}</h2>
        <ul>
          {servicos.map((s) => <li><a href={`/servicos/${s.slug}/`}>{s.nome}</a></li>)}
        </ul>

        <h2>Perguntas frequentes</h2>
        <FaqList items={faq} />
      </article>

      <aside class="sidebar">
        <div class="side-card">
          <h2>Desentupidora em {bairro.nome} agora</h2>
          <p>Fale com a gente e receba atendimento em até {site.arrivalMinutes} minutos.</p>
          <CtaButtons message={msg} size="md" />
        </div>
        <div class="side-list">
          <h2>Outras áreas</h2>
          <ul>
            {outrosBairros.map((b) => <li><a href={bairroPath(b)}>Desentupidora em {b.nome}</a></li>)}
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Serviços em {bairro.nome}</span>
        <h2>Serviços de desentupimento em {bairro.nome}</h2>
      </div>
      <div class="services-grid">
        {servicos.map((s) => <ServiceCard servico={s} />)}
      </div>
    </div>
  </section>

  <CtaBand title={`Desentupidora em ${bairro.nome} agora`} message={msg} />
</Base>
