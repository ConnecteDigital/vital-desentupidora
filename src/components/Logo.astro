---
// Logo oficial da Vital Desentupidora (fundo transparente): src/assets/logo-vital.png
import { Image } from 'astro:assets';
import logo from '../assets/logo-vital.png';
import { site } from '../data/site';

interface Props {
  size?: 'md' | 'lg';
}

const { size = 'md' } = Astro.props;
const width = size === 'lg' ? 260 : 180;
---

<Image class:list={['logo', `logo-${size}`]} src={logo} alt={site.name} width={width} densities={[1, 2]} loading={size === 'md' ? 'eager' : 'lazy'} />
