---
import CtaButtons from './CtaButtons.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  text?: string;
  message?: string;
}

const {
  title = 'Entupiu agora?',
  text = `Plantão 24 horas em ${site.region}. Chegamos em até ${site.arrivalMinutes} minutos.`,
  message,
} = Astro.props;
---

<section class="cta-band">
  <div class="container cta-band-inner">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <CtaButtons message={message} />
  </div>
</section>
