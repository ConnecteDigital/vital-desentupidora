---
import Base from '../layouts/Base.astro';
import CtaButtons from '../components/CtaButtons.astro';
import { site } from '../data/site';
---

<Base title={`Página não encontrada | ${site.shortName}`} description="Página não encontrada." noindex>
  <section class="hero page-hero">
    <div class="container">
      <h1>Página não encontrada</h1>
      <p class="hero-lead">Essa página não existe, mas o seu entupimento tem solução. Fale com a gente ou <a href="/" style="color:#ffb35c">volte ao início</a>.</p>
      <CtaButtons />
    </div>
  </section>
</Base>
